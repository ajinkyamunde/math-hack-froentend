# ---------------------------------------------------------------------------
# MathHack Frontend Configuration (local development only).
# Copy this file to .env.
# ---------------------------------------------------------------------------

# Leave empty: the Vite dev server proxies /api to the Worker running locally (`npm run dev` in the
# backend repo, port 8787), so cookies stay first-party. Set MATHHACK_BACKEND_URL to proxy elsewhere.
#
# In production nothing here is used: the browser calls /api on the site's own origin and
# vercel.json rewrites it to the Cloudflare Worker.
VITE_API_URL=
